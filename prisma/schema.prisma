generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  CLIENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  APPROVED_WITH_COMMENTS
  REVISE_RESUBMIT
}

enum PhaseStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  role          Role      @default(CLIENT)
  phone         String?
  avatar        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  projects      Project[] @relation("ClientProjects")
  managedProjects Project[] @relation("ManagerProjects")
}

model Project {
  id            String        @id @default(cuid())
  name          String
  clientId      String
  managerId     String?
  status        String        @default("active")
  startDate     DateTime      @default(now())
  expectedEnd   DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  client        User          @relation("ClientProjects", fields: [clientId], references: [id])
  manager       User?         @relation("ManagerProjects", fields: [managerId], references: [id])
  phases        Phase[]
  documents     Document[]
  approvals     Approval[]
  scheduleItems ScheduleItem[]
}

model Phase {
  id            String      @id @default(cuid())
  projectId     String
  number        Int
  name          String
  description   String?
  status        PhaseStatus @default(NOT_STARTED)
  startDate     DateTime?
  endDate       DateTime?
  order         Int         @default(0)
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps         Step[]

  @@unique([projectId, number])
}

model Step {
  id            String    @id @default(cuid())
  phaseId       String
  title         String
  description   String?
  isCompleted   Boolean   @default(false)
  completedAt   DateTime?
  completedBy   String?
  sampleUrl     String?
  sampleLabel   String?
  order         Int       @default(0)
  phase         Phase     @relation(fields: [phaseId], references: [id], onDelete: Cascade)
}

model Document {
  id            String    @id @default(cuid())
  projectId     String
  name          String
  description   String?
  url           String?
  phase         String?
  category      String?
  uploadedAt    DateTime  @default(now())
  uploadedBy    String?
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Approval {
  id            String         @id @default(cuid())
  projectId     String
  phase         String
  title         String
  description   String?
  status        ApprovalStatus @default(PENDING)
  priority      String         @default("required")
  approvedAt    DateTime?
  approvedBy    String?
  comments      String?
  order         Int            @default(0)
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ScheduleItem {
  id            String    @id @default(cuid())
  projectId     String
  phase         String
  title         String
  duration      String?
  startDate     DateTime?
  endDate       DateTime?
  milestones    String?
  order         Int       @default(0)
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
